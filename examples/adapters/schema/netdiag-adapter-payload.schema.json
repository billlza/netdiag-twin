{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netdiag.local/schemas/netdiag-adapter-payload/v2",
  "title": "NetDiag Adapter Payload",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "collection_mode",
    "sample",
    "protocol",
    "flow_count",
    "measurement_quality",
    "records",
    "experiment"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "netdiag-adapter-payload/v2"
    },
    "collection_mode": {
      "type": "string",
      "enum": ["sample", "live"]
    },
    "sample": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "flow_count": {
      "type": "integer",
      "minimum": 0
    },
    "measurement_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_ms",
        "jitter_ms",
        "packet_loss_rate",
        "retransmission_rate",
        "timeout_events",
        "retry_events",
        "throughput_mbps",
        "dns_failure_events",
        "tls_failure_events",
        "quic_blocked_ratio"
      ],
      "properties": {
        "latency_ms": { "$ref": "#/$defs/measurementQuality" },
        "jitter_ms": { "$ref": "#/$defs/measurementQuality" },
        "packet_loss_rate": { "$ref": "#/$defs/measurementQuality" },
        "retransmission_rate": { "$ref": "#/$defs/measurementQuality" },
        "timeout_events": { "$ref": "#/$defs/measurementQuality" },
        "retry_events": { "$ref": "#/$defs/measurementQuality" },
        "throughput_mbps": { "$ref": "#/$defs/measurementQuality" },
        "dns_failure_events": { "$ref": "#/$defs/measurementQuality" },
        "tls_failure_events": { "$ref": "#/$defs/measurementQuality" },
        "quic_blocked_ratio": { "$ref": "#/$defs/measurementQuality" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "latency_ms",
          "jitter_ms",
          "packet_loss_rate",
          "retransmission_rate",
          "timeout_events",
          "retry_events",
          "throughput_mbps",
          "dns_failure_events",
          "tls_failure_events",
          "quic_blocked_ratio"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "minLength": 1
          },
          "latency_ms": { "type": "number", "minimum": 0 },
          "jitter_ms": { "type": "number", "minimum": 0 },
          "packet_loss_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "retransmission_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "timeout_events": { "type": "number", "minimum": 0 },
          "retry_events": { "type": "number", "minimum": 0 },
          "throughput_mbps": { "type": "number", "minimum": 0 },
          "dns_failure_events": { "type": "number", "minimum": 0 },
          "tls_failure_events": { "type": "number", "minimum": 0 },
          "quic_blocked_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scenario_id", "fault_start", "fault_end", "ground_truth"],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "fault_start": { "type": "string" },
        "fault_end": { "type": "string" },
        "ground_truth": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "measurementQuality": {
      "type": "string",
      "enum": ["measured", "estimated", "fallback", "missing"]
    }
  }
}
